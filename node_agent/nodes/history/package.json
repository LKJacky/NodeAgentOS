{
  "name": "node-agent-history",
  "version": "0.1.0",
  "type": "module",
  "publisher": "node-agent",
  "description": "Durable conversation history for TypeScript and Python agents: SQLite in-process, or a shared history server with one token per user",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "node ../../../scripts/sync-licenses.mjs",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "pretest": "npm run build",
    "test": "node --import ./test/ts-resolve.mjs --test test/*.test.ts"
  },
  "node": {
    "id": "history",
    "i18n": "dist/i18n",
    "desc": "Durable JSON units private to each node and user, each at a revision the caller names",
    "entry": "dist/index.js",
    "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#64748b\" stroke-width=\"2\"><ellipse cx=\"12\" cy=\"5\" rx=\"8\" ry=\"3\"/><path d=\"M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5\"/><path d=\"M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3\"/></svg>",
    "caps": {
      "load": {
        "type": "object",
        "required": [
          "unitId"
        ],
        "properties": {
          "unitId": {
            "type": "string",
            "description": "Any name the owner chose, dots included"
          }
        },
        "callers": [
          "*"
        ],
        "allow_edit_permission": false
      },
      "save": {
        "type": "object",
        "required": [
          "unitId",
          "meta"
        ],
        "properties": {
          "unitId": {
            "type": "string",
            "description": "Any name the owner chose, dots included"
          },
          "meta": {
            "description": "Any JSON: the whole value of the unit"
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0,
            "description": "0 means create only; otherwise update only this revision"
          }
        },
        "callers": [
          "*"
        ],
        "allow_edit_permission": false
      },
      "delete": {
        "type": "object",
        "required": [
          "unitId",
          "expectedRevision"
        ],
        "properties": {
          "unitId": {
            "type": "string",
            "description": "Any name the owner chose, dots included"
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 1,
            "description": "Update only this revision"
          }
        },
        "callers": [
          "*"
        ],
        "allow_edit_permission": false
      },
      "list": {
        "type": "object",
        "properties": {},
        "callers": [
          "*"
        ],
        "allow_edit_permission": false
      }
    }
  },
  "engines": {
    "node": ">=23.6"
  },
  "dependencies": {
    "@node-agent/sdk": "^0.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LKJacky/NodeAgentOS.git",
    "directory": "node_agent/nodes/history"
  },
  "homepage": "https://github.com/LKJacky/NodeAgentOS#readme",
  "bugs": {
    "url": "https://github.com/LKJacky/NodeAgentOS/issues"
  }
}
