{
  "name": "@node-agent/runtime",
  "version": "0.1.0",
  "type": "module",
  "description": "The runtime: one shared bus, nodes as worker threads, and the small HTTP surface over it",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "node ../../scripts/sync-licenses.mjs",
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=23.6"
  },
  "dependencies": {
    "node-agent-bus": "file:../bus"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LKJacky/NodeAgentOS.git",
    "directory": "node_agent/runtime"
  },
  "homepage": "https://github.com/LKJacky/NodeAgentOS#readme",
  "bugs": {
    "url": "https://github.com/LKJacky/NodeAgentOS/issues"
  }
}
