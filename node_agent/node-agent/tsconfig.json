{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "composite": true,
    "declaration": true,
    "sourceMap": true,
    "types": [
      "node"
    ],
    "rootDir": "src",
    "outDir": "dist",
    "paths": {
      "@node-agent/runtime": [
        "../runtime/dist/index.d.ts"
      ],
      "node-agent-agent": [
        "../nodes/agent/dist/index.d.ts"
      ],
      "node-agent-bus": [
        "../bus/dist/index.d.ts"
      ],
      "node-agent-history": [
        "../nodes/history/dist/index.d.ts"
      ]
    }
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "../nodes/agent"
    },
    {
      "path": "../bus"
    },
    {
      "path": "../nodes/history"
    }
  ]
}
