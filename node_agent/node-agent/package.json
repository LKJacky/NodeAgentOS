{
  "name": "@node-agent/local",
  "version": "0.1.0",
  "type": "module",
  "description": "Run NodeAgentOS locally: one persistent agent, one bus, and the core nodes in a single command.",
  "bin": {
    "node-agent": "./dist/serve.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "node ../../scripts/sync-licenses.mjs",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.mjs",
    "build": "tsc -p tsconfig.json && node scripts/copy-runtime.mjs"
  },
  "node": {
    "id": "node-agent",
    "desc": "The core in one process: the bus + the history node + the agent, then whatever NODE_AGENT_NODES names",
    "caps": [],
    "bin": "node-agent"
  },
  "engines": {
    "node": ">=23.6"
  },
  "dependencies": {
    "@node-agent/sdk": "^0.1.1",
    "node-agent-agent": "^0.1.0",
    "node-agent-bus": "^0.1.0",
    "node-agent-history": "^0.1.0",
    "node-agent-introduce": "^0.1.0",
    "node-agent-notes": "^0.1.2",
    "node-agent-provider": "^0.1.4",
    "node-agent-search": "^0.1.0",
    "node-agent-system": "^0.1.0",
    "node-agent-timer": "^0.2.0",
    "node-agent-todo": "^0.1.0",
    "node-agent-webui": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "@node-agent/runtime": "^0.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LKJacky/NodeAgentOS.git",
    "directory": "node_agent/node-agent"
  },
  "homepage": "https://github.com/LKJacky/NodeAgentOS#readme",
  "bugs": {
    "url": "https://github.com/LKJacky/NodeAgentOS/issues"
  },
  "keywords": [
    "agent",
    "node-agent",
    "nodeagentos",
    "self-hosted",
    "ai"
  ],
  "publishConfig": {
    "access": "public"
  }
}
