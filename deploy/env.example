# One file for both modes: copy it beside the compose file.
#
#     cp deploy/env.example deploy/.env
#
# A local start (`up -d`) reads the token and the model and nothing else.

# The token is the only credential a node uses: a node that joins the bus presents it, and the Web UI is
# reachable only from this host unless you publish the port. Generate one with `openssl rand -hex 32`.
NODE_AGENT_TOKEN=change-me

# The model. OpenAI-compatible; BYOK. Left empty, the agent answers with its deterministic stand-in.
NODE_AGENT_MODEL_URL=
NODE_AGENT_MODEL_KEY=
NODE_AGENT_MODEL_NAME=

# What the shell node may touch, and where it starts. Both default to the container's /data.
#NODE_AGENT_WORKSPACE=/data/workspace

# The page. Published on 127.0.0.1:8790 by docker-compose.yml.
#NODE_AGENT_WEBUI_PORT=8790

# Chatty logs while bringing the stack up for the first time.
#NODE_AGENT_LOG_LEVEL=debug

# --- public profile ------------------------------------------------------------------------------
# Everything below is only read when you start with `--profile public`; a local `up -d` ignores it.

# The switch for the built-in door, and the token typed into the browser at /login. Not
# NODE_AGENT_TOKEN — that one is the credential a node uses to join the bus. Set it to put the page
# behind a login; leave it empty and the door does not listen at all and Caddy answers 502.
#NODE_AGENT_ACCESS_TOKEN=

# The bare name DNS points at this host: no scheme, no path. Caddy asks a CA for a certificate for
# exactly this name, so the record has to exist (and 80/443 reach the host) before the first start.
# Use `localhost` for a try on one machine: Caddy then signs it with its own local CA.
#NODE_AGENT_DOMAIN=agent.example.com

# Only used for ACME expiry notices.
#ACME_EMAIL=you@example.com

# Where the door listens inside the container. Caddy proxies to it over the compose network; nothing
# publishes this port to the host.
#NODE_AGENT_PROXY_PORT=8080

# Caddy terminates TLS, so the login cookie can be marked Secure.
#NODE_AGENT_PROXY_SECURE=1
