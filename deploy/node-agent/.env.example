# Running the stack on the host, without docker: one process, all the core nodes in it.
#
#     npm install && npm run build
#     cp deploy/node-agent/.env.example deploy/node-agent/.env
#     node --env-file=deploy/node-agent/.env node_agent/node-agent/dist/serve.js
#
# This file is the single-process assembly: `node_agent/node-agent` starts the bus, then the history,
# agent and system nodes, then the provider and the Web UI (NODE_AGENT_NODES). It is what
# deploy/Dockerfile runs, with the paths pointed at /data.

NODE_AGENT_TOKEN=change-me

# Loopback by default. A token is required before widening either of these.
NODE_AGENT_BUS_BIND=127.0.0.1
NODE_AGENT_BUS_PORT=8788
NODE_AGENT_WEBUI_BIND=127.0.0.1
NODE_AGENT_WEBUI_PORT=8790

# The model: OpenAI-compatible, BYOK. Empty means the agent's deterministic stand-in answers.
NODE_AGENT_MODEL_URL=
NODE_AGENT_MODEL_KEY=
NODE_AGENT_MODEL_NAME=

# Where the history database and the runtime's node logs live.
#NODE_AGENT_HOME=~/.node_agent

# The directory the shell node starts in.
#NODE_AGENT_WORKSPACE=.

# Optional: the built-in door in front of the page - one token, one login page, one more port. Off
# unless set. Give it a token of its own, not the NODE_AGENT_TOKEN above: this one is typed into a
# browser, that one is the credential a node uses to join the bus.
#NODE_AGENT_ACCESS_TOKEN=
#NODE_AGENT_PROXY_BIND=127.0.0.1
#NODE_AGENT_PROXY_PORT=8080
# Behind TLS (the `public` profile of deploy/docker-compose.yml puts Caddy there), set this to 1 so the
# login cookie is marked Secure; over plain HTTP leave it at 0.
#NODE_AGENT_PROXY_SECURE=0
